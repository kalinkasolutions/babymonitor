<?xml version="1.0" encoding="utf-8"?>
<!--
  System anchors only, and deliberately no domain-config. Any per-domain rule makes Android refuse
  certificate checks that do not name the host, and WebRTC's check for a turns: relay never does,
  so one rule here would break the TLS relay for every server. The dev CA lives in the debug copy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
