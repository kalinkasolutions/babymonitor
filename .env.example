# Copy to .env and fill in real values; docker-compose.yml reads these to override the
# appsettings.json sections. .env is gitignored — do not commit real credentials.

# --- Environment ---
# Development also creates the seed accounts from appsettings.Development.json, which have known
# passwords. Only set it on a machine where that is acceptable.
ASPNETCORE_ENVIRONMENT=Production

# --- Logging ---
# Minimum log level for console output and the SQLite "Logs" table.
# One of: Trace, Debug, Information, Warning, Error, Critical. Defaults to Information.
LOG_LEVEL=Information
# Days a log line is kept before the sink prunes it. The table lives in the app's own database.
LOG_RETENTION_DAYS=30

# --- Email ---
# Used for account confirmation, password resets and invitations. Leave EMAIL_SMTP_HOST blank to
# run without a mail server: mails are logged and dropped rather than failing the operation that
# triggered them, which is fine until you want to invite somebody who is not in the room.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=apikey
EMAIL_PASSWORD=change-me
EMAIL_FROM_ADDRESS=no-reply@babyphone.example.com
EMAIL_FROM_NAME=Babyphone
# One of: None, Auto, SslOnConnect, StartTls, StartTlsWhenAvailable
EMAIL_SECURE_SOCKET_OPTIONS=StartTls
# Public origin of the API (no trailing slash). Confirmation and invitation links are followed
# from a mail client and land on the API itself, so this has to be reachable from a browser.
EMAIL_BASE_URL=https://baby.kalinka-work.lqy.ch

# --- Relay (TURN) ---
# Shared between the backend and coturn: the backend signs credentials with it and coturn
# recomputes the same signature, so the relay has no accounts to provision.
#   openssl rand -base64 32
# Leave blank to run with no relay. Two phones on one WiFi never need one, and most connections
# across the internet succeed without it — it mainly earns its keep when a phone is on mobile
# data, where carrier NAT often defeats hole punching.
TURN_SECRET=

# Where the phones send relayed media. This is UDP straight to the Docker host and cannot be put
# behind a reverse proxy, so the name must resolve to that host's own public address and its ports
# must be forwarded to it. Not the same name as the API if they are on different machines.
TURN_HOST=turn.example.com

# Where the phones find the relay over TLS — whatever holds the certificate, which is usually the
# proxy in front rather than the Docker host. It listens on 5349 and forwards plain TCP to
# TURN_HOST:3478. Set it to TURN_HOST if this host terminates its own TLS.
TURNS_HOST=baby.example.com

# Which of the host's addresses coturn binds. Pin this: with host networking it otherwise binds
# every Docker bridge as well and offers relay candidates nobody can use. Repeat the flag in
# docker-compose.yml to bind more than one.
# Lets the relay carry traffic to private addresses, which it otherwise refuses so it cannot be
# used to reach inside the network. Only ever set to test the relay between two phones on one
# LAN — for example 10.0.0.0-10.255.255.255 — and cleared again afterwards.
TURN_TEST_PEERS=

TURN_LISTENING_IP=10.10.0.174

# Certificate for turns: on 5349. The wildcard nginx already uses is fine.
# coturn runs as nobody by default and cannot read a mode-600 key; the container runs as this
# uid/gid instead, which must be the key file's owner. `stat -c '%u:%g' <keyfile>` to check.
TLS_KEY_UID=1000
TLS_KEY_GID=1000

TLS_CERT_PATH=/etc/ssl/certs/kalinka-work-wildcard.crt
TLS_KEY_PATH=/etc/ssl/private/kalinka-work-wildcard.key
