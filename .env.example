# Copy to .env and fill in real values; docker-compose.yml reads these to override the
# appsettings.json sections. .env is gitignored — do not commit real credentials.

# --- Environment ---
# Development also creates the seed accounts from appsettings.Development.json, which have known
# passwords. Only set it on a machine where that is acceptable.
ASPNETCORE_ENVIRONMENT=Production

# --- Reverse proxy ---
# nginx terminates TLS and forwards plain HTTP, so the app only knows the request was secure
# because the proxy says so. That header is forgeable, so it is believed only from an address
# named here. The framework's own default is loopback, which inside a container means nobody at
# all — the proxy always arrives as something else — so leaving both of these unset means the
# headers are ignored and every request looks like cleartext from the proxy's own address.
#
# Which address the proxy appears as depends on how it reaches the published port, which is why
# there is no sensible default to hard-code:
#   nginx dialling 127.0.0.1 on this host  -> the Docker bridge gateway, e.g. 172.17.0.1
#   nginx dialling this host's own address -> that address
#   nginx on another machine               -> that machine's address
#
# Simplest when nothing but the proxy can reach the port, which is the default below.
PROXY_TRUST_ANY=true

# Where the app listens on the host. Loopback unless nginx is somewhere else, because anything
# that can reach this port can claim to be the proxy and be believed.
APP_BIND_ADDRESS=127.0.0.1

# Use these two together instead when nginx is on another machine: bind every interface and name
# that machine rather than trusting whoever calls. An address or a CIDR range.
#APP_BIND_ADDRESS=0.0.0.0
#PROXY_TRUST_ANY=false
#PROXY_TRUSTED=10.0.0.5

# --- Rate limits ---
# How hard the endpoints an outsider can reach may be hammered, counted per address. A household
# is one address, so every phone behind it shares a budget — these are set where a family never
# notices them and somebody working through a list of addresses does. Guessing one account's
# password has a second defence that does not depend on the address: Identity locks the account.
RATE_LIMIT_CREDENTIALS=20
RATE_LIMIT_PAIRING_CLAIMS=10
RATE_LIMIT_INVITES=5

# --- Logging ---
# Minimum log level for console output and the SQLite "Logs" table.
# One of: Trace, Debug, Information, Warning, Error, Critical. Defaults to Information.
LOG_LEVEL=Information
# Days a log line is kept before the sink prunes it. The table lives in the app's own database.
LOG_RETENTION_DAYS=30

# --- Email ---
# Used for account confirmation, password resets and invitations. Leave EMAIL_SMTP_HOST blank to
# run without a mail server: mails are logged and dropped rather than failing the operation that
# triggered them, which is fine until you want to invite somebody who is not in the room.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=apikey
EMAIL_PASSWORD=change-me
EMAIL_FROM_ADDRESS=no-reply@babymonitor.example.com
EMAIL_FROM_NAME=Babymonitor
# One of: None, Auto, SslOnConnect, StartTls, StartTlsWhenAvailable
EMAIL_SECURE_SOCKET_OPTIONS=StartTls
# Public origin of the API (no trailing slash). Confirmation and invitation links are followed
# from a mail client and land on the API itself, so this has to be reachable from a browser.
EMAIL_BASE_URL=https://baby.example.com

# --- Relay (TURN) ---
# Only needed when the phones cannot reach each other directly, mostly on mobile data. Leave
# TURN_SECRET blank to run without a relay.

# Shared by the backend and coturn, so the relay needs no accounts.  openssl rand -base64 32
TURN_SECRET=

# Must resolve to the public address that forwards 3478 (UDP and TCP) and 49160-49200 (UDP) to
# the Docker host. The relay ports have to reach coturn directly, not through a proxy.
TURN_HOST=turn.example.com

# TURN over TLS on 5349, optional: only for networks that block plain TURN, like company WiFi.
# Point it at whatever holds the certificate, usually nginx's stream block.
TURNS_HOST=baby.example.com

# The Docker host's LAN address for coturn to bind. Not 0.0.0.0: it would bind the Docker bridges
# too. Behind NAT, also set external-ip in deploy/turn/turnserver.conf.
TURN_LISTENING_IP=10.0.0.10

# Leave blank. Lets the relay reach private addresses, which is only for testing it between two
# phones on one LAN, e.g. 10.0.0.0-10.255.255.255.
TURN_TEST_PEERS=

# --- Relay TLS in coturn itself ---
# Only with docker-compose.turns.yml, when the Docker host holds the certificate instead of nginx.
# Then set TURNS_HOST to TURN_HOST. The uid/gid must own the key:  stat -c '%u:%g' <keyfile>
#TLS_CERT_PATH=/etc/ssl/certs/example.crt
#TLS_KEY_PATH=/etc/ssl/private/example.key
#TLS_KEY_UID=1000
#TLS_KEY_GID=1000
