# Copy to .env and fill in real values; docker-compose.yml reads these to override the
# appsettings.json sections. .env is gitignored — do not commit real credentials.

# --- Environment ---
# Development only adds the cause of a server error to the response.
ASPNETCORE_ENVIRONMENT=Production

# --- Reverse proxy ---
# Pick the block that matches where nginx runs, and leave the other commented out. The app only
# believes nginx's "this was HTTPS, from this client" headers from a caller it trusts.

# The port nginx forwards to, if 7881 is taken on this host.
#APP_PORT=7881

# nginx on this same machine: the port listens on loopback only, so every caller is nginx.
APP_BIND_ADDRESS=127.0.0.1
PROXY_TRUST_ANY=true

# nginx on another machine: listen on the network, and trust only nginx's address or range.
#APP_BIND_ADDRESS=0.0.0.0
#PROXY_TRUST_ANY=false
#PROXY_TRUSTED=10.0.0.5

# --- Logging ---
# Minimum log level for console output.
# One of: Trace, Debug, Information, Warning, Error, Critical. Defaults to Information.
LOG_LEVEL=Information

# How much the phones upload, if it should differ from LOG_LEVEL. Debug or Verbose adds WebRTC's
# own lines about every connection attempt: a lot, so only while looking into a problem.
#PHONE_LOG_LEVEL=Debug

# Also send the log to Loki, including the lines the phones upload. Off unless both are set.
LOKI_ENABLED=false
LOKI_URI=http://loki.example.ch:3100

# --- Relay (TURN) ---
# Only needed when the phones cannot reach each other directly, mostly on mobile data. Leave
# TURN_SECRET blank to run without a relay.

# Shared by the backend and coturn, so the relay needs no accounts.  openssl rand -base64 32
TURN_SECRET=

# Must resolve to the public address that forwards 3478 (UDP and TCP) and 49160-49200 (UDP) to
# the Docker host. The relay ports have to reach coturn directly, not through a proxy. Inside your
# own network too: if a wildcard there sends every name to nginx, give this one its own entry
# pointing at the Docker host, or phones at home never get a relay.
TURN_HOST=turn.example.com

# TURN over TLS on 5349, optional: only for networks that block plain TURN, like company WiFi.
# Point it at whatever holds the certificate, usually nginx's stream block.
TURNS_HOST=baby.example.com

# The Docker host's LAN address for coturn to bind. Not 0.0.0.0: it would bind the Docker bridges
# too.
TURN_LISTENING_IP=10.0.0.10

# Behind NAT: the public address the relay hands out, e.g. 203.0.113.7. Without it the relay
# advertises its private address and nobody outside can reach it. The public address alone, not
# "public/private": coturn lets anyone relay to the private part, and that is this host.
TURN_EXTERNAL_IP=

# Set to anything to have coturn log every allocation, permission and refusal, with addresses.
# Only while looking into a problem.
#TURN_VERBOSE=true

# Leave blank. Lets the relay reach private addresses, which is only for testing it between two
# phones on one LAN, e.g. 10.0.0.0-10.255.255.255.
TURN_TEST_PEERS=

# --- Relay TLS in coturn itself ---
# Only with docker-compose.turns.yml, when the Docker host holds the certificate instead of nginx.
# Then set TURNS_HOST to TURN_HOST. The uid/gid must own the key:  stat -c '%u:%g' <keyfile>
#TLS_CERT_PATH=/etc/ssl/certs/example.crt
#TLS_KEY_PATH=/etc/ssl/private/example.key
#TLS_KEY_UID=1000
#TLS_KEY_GID=1000
