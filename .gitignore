# .NET
bin/
obj/
*.db
*.db-shm
*.db-wal

# Android
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.idea/
*.apk

# Byte-compiled verify-apk.py, which the tooling writes beside the script it belongs to.
__pycache__/

# Secrets
.env
data/
# The release signing key. The workflow writes this out of a secret at build time; it must never
# be committed, and losing it means no future release can upgrade the app people already have.
*.jks
*.keystore
